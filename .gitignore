# --- Build output / dependencies (regenerated by the build) ---
node_modules/
**/node_modules/
backend/target/
**/dist/

# tsc -b byproducts of typechecking vite.config.ts
*.tsbuildinfo
**/vite.config.js
**/vite.config.d.ts

# --- Machine-specific / generated at start ---
# HTTPS cert generated per machine by the launcher
certs/
# this PC's mkcert root CA (recipient generates their own)
votevox-rootCA.pem

# --- Logs ---
*.log
logs/

# --- Editor / OS ---
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# --- Local env overrides (keep .env.example committed) ---
*.local
