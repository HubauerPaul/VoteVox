# Base URL embedded in the generated QR codes. Must be reachable from the
# phones that scan them.
#
# Default = LAN over HTTPS (same-WiFi; phones see a cert warning unless the
# mkcert root CA is installed). Update the IP if your PC's LAN address changes.
VITE_QR_BASE_URL=https://192.168.178.44:5173/vote

# To let voters be on ANY network (no warning), run  .\start-all.ps1 -Tunnel
# (or .\start-tunnel.ps1) - it overwrites this file with the Cloudflare URL.
